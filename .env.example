# Telegram Client Login Bot - 环境变量配置示例
# 复制此文件为 .env 并填入真实值（.env 已被 git 忽略，不会入库）

# --- 机器人 ---
# Bot Token (从 @BotFather 获取)
BOT_TOKEN=your_bot_token_here
# 短信投递 worker（认领统一后端队列经 Telethon 发送会话投递）
# SMS_WORKER_ENABLED=true
# SMS_POLL_INTERVAL=15
# SMS_SENDER_SESSION=your_telethon_string_session
# 防封：无人使用自动停机分钟数（0=关闭，默认30；停机后由后台手动启动）
# IDLE_STOP_MINUTES=30
# 调统一后端认领接口的 Key（与后端 API_KEY 一致，开鉴权时必填）
# API_KEY=your_api_key_here
# 后端服务地址（容器内用服务名，本地用 localhost）
BACKEND_URL=http://backend:8000
# 会话转换接口地址（R1起并入统一后端8000，无独立转换服务）
CONVERTER_URL=http://backend:8000/to-tdata

# --- Telegram API 配置（从 https://my.telegram.org 获取，勿提交真实值） ---
API_ID=your_api_id_here
API_HASH=your_api_hash_here

# --- 后台登录 ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-in-production
# 以下二选一：直接给明文密码（开发用），或给 argon2 哈希（生产用，见 README 生成方法）
# ADMIN_PASSWORD_HASH=$argon2id$v=19$m=65536,t=3,p=4$...

# --- 鉴权与密钥 ---
# JWT 密钥（不设则首次启动自动生成并落盘 .jwt_secret）
JWT_SECRET=your-secret-key-change-this
# API 鉴权配置（生产环境建议启用）
API_KEY=your_api_key_here
ENABLE_AUTH=false

# --- 数据库（二选一：DATABASE_URL 优先） ---
# DATABASE_URL=mysql+pymysql://telegram:telegrampass@db:3306/telegramdb?charset=utf8mb4
DB_HOST=db
DB_PORT=3306
DB_USER=telegram
DB_PASSWORD=telegrampass
DB_NAME=telegramdb

# --- Redis（二选一：REDIS_URL 优先，连不上自动降级内存） ---
# REDIS_URL=redis://redis:6379/0
REDIS_HOST=redis
REDIS_PORT=6379

# --- 其他 ---
# 跨域白名单（逗号分隔，8000 已内置，旧8002保留兼容）
# ALLOWED_ORIGINS=https://your-domain.com
# 备份目录（不设则自动探测 Docker 卷 /backups 或项目内 backups）
# BACKUP_DIR=/backups
# 机器人脚本位置（自动定位失败时手动指定）
# BOT_SCRIPT=C:\path\to\bot\bot.py
# 统一后端端口（本地脚本用）
# API_PORT=8000
