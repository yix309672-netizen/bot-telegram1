# Telegram Client Login Bot - 环境变量配置示例
# 复制此文件为 .env 并填入真实值

# Bot Token (从 @BotFather 获取)
BOT_TOKEN=your_bot_token_here

# 后端服务地址
BACKEND_URL=http://backend:8000

# Telegram API 配置
API_ID=31541553
API_HASH=21dc9ae5c7d205f68207ac620166dfa0

# JWT 密钥
JWT_SECRET=your-secret-key-change-this

# API 鉴权配置（生产环境建议启用）
API_KEY=your_api_key_here
ENABLE_AUTH=false

# 数据库配置
DB_HOST=db
DB_PORT=3306
DB_USER=telegram
DB_PASSWORD=telegrampass
DB_NAME=telegramdb

# Redis 配置
REDIS_HOST=redis
REDIS_PORT=6379
